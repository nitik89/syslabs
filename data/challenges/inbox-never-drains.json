{
  "id": "inbox-never-drains",
  "order": 13,
  "title": "The Inbox That Never Drains",
  "difficulty": "Medium",
  "summary": "Messages are accepted instantly, then arrive hours later. The queue is fine. The worker behind it isn't.",
  "scenario": [
    "A messaging app handles 6,000 requests per second, 80% of them sending messages. To keep sends snappy, the API puts each message on a queue and returns immediately.",
    "One Background Worker pulls messages off the queue and writes them to the database. It can process 2,000 per second.",
    "Users see \"sent\", but their friends get the messages hours late. The backlog grows every second. Drain it, with headroom to spare."
  ],
  "objectives": [
    {
      "id": "backlog",
      "label": "No queue backlog",
      "metric": "backlogRps",
      "op": "<=",
      "value": 0
    },
    {
      "id": "headroom",
      "label": "No component above 75% utilization",
      "metric": "maxUtilization",
      "op": "<=",
      "value": 0.75
    },
    {
