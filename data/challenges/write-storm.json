{
  "id": "write-storm",
  "order": 10,
  "title": "Write Storm",
  "difficulty": "Medium",
  "summary": "A fleet of IoT sensors writes 3,600 readings per second into a SQL database. Adding read replicas didn't help.",
  "scenario": [
    "A smart-thermostat company has 4,000 requests per second, and 90% of them are devices writing sensor readings.",
    "The team saw the database overloaded and added read replicas, three of them. The error rate barely moved, and the bill went up.",
    "Handle the write load reliably and keep at least 20% headroom everywhere."
  ],
