{
  "id": "ad-click-aggregator",
  "order": 23,
  "title": "Ad Click Aggregator",
  "difficulty": "Hard",
  "summary": "Ingest a firehose of ad clicks, aggregate them per campaign per minute, and power billing dashboards.",
  "scenario": [
    "Advertisers pay per click, so every click must be counted exactly once, and dashboards must be close to real time.",
    "Clicks arrive in huge bursts; reads are a small number of dashboard queries."
  ],
  "mode": "build",
  "category": "Data",
  "requirements": {
    "functional": [
      "Record every ad click",
      "Aggregate clicks per ad and campaign per minute",
      "Show advertisers near-real-time dashboards",
      "Never lose or double-count a click"
    ],
    "nonFunctional": [
      "Handle 40,000 requests/s at peak, 95% clicks",
      "Aggregation keeps up: no backlog",
      "Error rate at or below 0.5%",
      "No single points of failure",
      "Cost under $6,900 / month"
    ]
  },
  "estimates": [
    "40,000 click events/s at peak",
    "2,000 dashboard reads/s",
    "Clicks for a few big campaigns dominate"
  ],
