  "hints": [
    "AI request share is fixed at 60% here. What happens when 480 calls/s hit a model capped at 500?",
    "RAG = retrieve then generate: the Chat API reads from a vector index and a conversation store, then calls the model. Answers should stream.",
    "Client \u2192 SSE (2) \u2192 Chat API (2) \u2192 Claude (2 replicas, i.e. two deployments for rate limit headroom) + Pinecone + DynamoDB."
  ],
  "scoring": {
    "weights": {
      "performance": 0.35,
      "reliability": 0.3,
      "cost": 0.15,
      "architecture": 0.2
