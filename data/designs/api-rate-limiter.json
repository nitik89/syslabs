{
  "id": "api-rate-limiter",
  "order": 14,
  "title": "API Rate Limiter",
  "difficulty": "Medium",
  "summary": "Put a rate-limited front door in front of a public API so one abusive client can't take it down for everyone.",
  "scenario": [
    "Your public API serves 20,000 requests per second from thousands of API keys. Last week one buggy client sent 10× its normal traffic and everyone else got timeouts.",
    "Every request must be authenticated and counted against its key's quota, and the counting itself must not become the bottleneck."
  ],
  "mode": "build",
  "category": "Platform",
  "requirements": {
    "functional": [
      "Authenticate every request by API key",
      "Enforce a per-key quota (requests per minute)",
      "Reject over-quota requests with HTTP 429",
      "Serve normal API reads and writes behind the limiter"
    ],
    "nonFunctional": [
      "Handle 20,000 requests/s at peak",
      "Counter checks add little latency: average at or below 50 ms",
      "Error rate at or below 1%",
      "No single points of failure, including the limiter",
      "Cost under $3,000 / month"
    ]
  },
  "estimates": [
    "20,000 requests/s across all keys",
    "85% of API calls are reads, mostly for a few hot resources",
    "Each request = one counter increment in a shared store"
  ],
  "objectives": [
    {
      "id": "errors",
      "label": "Error rate at or below 1%",
      "metric": "errorRate",
      "op": "<=",
      "value": 0.01
    },
    {
      "id": "latency",
      "label": "Average latency at or below 50 ms",
      "metric": "avgLatencyMs",
      "op": "<=",
      "value": 50
    },
    {
      "id": "spof",
      "label": "No single points of failure",
      "metric": "spofCount",
      "op": "==",
      "value": 0
    },
    {
      "id": "cost",
      "label": "Monthly cost at or below $3,000",
      "metric": "monthlyCost",
      "op": "<=",
      "value": 3000
    },
    {
      "id": "uses-limiter",
      "label": "Requests pass through a rate limiter or API gateway",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "rateLimiter",
        "apiGateway"
      ]
    },
    {
      "id": "uses-cache",
      "label": "Hot reads and counters live in a cache",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "cache"
      ]
    }
  ],
