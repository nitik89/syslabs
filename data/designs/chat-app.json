{
  "id": "chat-app",
  "order": 2,
  "title": "Chat App",
  "difficulty": "Medium",
  "summary": "Design a WhatsApp-style messenger: instant delivery, message history and offline users.",
  "scenario": [
    "Users send one-to-one and group messages that should appear instantly on the other person's phone.",
    "Phones keep a connection open to receive messages. Users who are offline get their messages when they reconnect."
  ],
  "mode": "build",
  "category": "Messaging",
  "requirements": {
    "functional": [
      "Send and receive messages in real time",
      "Load recent conversation history",
      "Deliver messages to users who were offline",
      "Show online / last seen status"
    ],
    "nonFunctional": [
      "Message delivery under 50 ms on average",
      "No single point of failure",
      "Messages are never dropped (queues keep up)"
    ]
  },
  "estimates": [
    "50M daily users, 40 messages each ≈ 20,000 requests/s at peak",
    "Half are sends (writes), half are history loads (reads)",
    "Recent conversations and presence are hot"
  ],
  "objectives": [
