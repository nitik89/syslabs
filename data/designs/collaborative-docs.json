{
  "id": "collaborative-docs",
  "order": 9,
  "title": "Collaborative Docs",
  "difficulty": "Hard",
  "summary": "Design a Google Docs-style editor: many people typing in the same document, live, without overwriting each other.",
  "scenario": [
    "Users open documents and edit them together, seeing each other's cursors and changes live.",
    "Two people often edit the same paragraph at the same moment; edits must not be lost."
  ],
  "mode": "build",
  "category": "Productivity",
  "requirements": {
    "functional": [
      "Open and edit documents",
      "See collaborators' edits live",
      "Never lose concurrent edits",
      "Load the editor app quickly"
    ],
    "nonFunctional": [
      "Edits apply in under 50 ms on average",
      "No lost edits",
      "No single point of failure",
      "Cost under $1,600 / month"
    ]
  },
  "estimates": [
    "8,000 requests/s at peak, 20% of them editor assets (JS, fonts)",
    "Half of API calls are edits",
    "60% of edits collide with someone else's"
  ],
