{
  "id": "digital-wallet",
  "order": 33,
  "title": "Digital Wallet",
  "difficulty": "Hard",
  "summary": "Design a Paytm/Venmo-style wallet: send money between users without ever creating or losing a rupee.",
  "scenario": [
    "Users check balances constantly and send money to friends and shops. During festivals, transfers spike.",
    "Two transfers from the same wallet at once must not overdraw it, and every movement must be recorded in an append-only ledger."
  ],
  "mode": "build",
  "category": "Fintech",
  "requirements": {
    "functional": [
      "Check wallet balance and history",
      "Send money to another user",
      "Record every transfer in a ledger",
      "Reject transfers that would overdraw"
    ],
    "nonFunctional": [
      "Handle 6,000 requests/s at peak, 70% reads",
      "No unsafe concurrent balance updates",
      "Ledger writes processed without backlog",
      "Error rate at or below 0.5%",
      "No single points of failure",
      "Cost under $1,800 / month"
    ]
  },
  "estimates": [
    "6,000 requests/s at peak",
    "1,800 transfers/s",
    "Half of all transfers touch a wallet another transfer is also using"
