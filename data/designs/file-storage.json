  "hints": [
    "Separate file contents from file metadata. They have completely different sizes, access patterns and consistency needs.",
    "Uploads can be acknowledged and then processed (hashing, dedup, notifying other devices) by workers.",
    "LB (2) → API (8) → S3 for chunks, API → Redis → DynamoDB for metadata, API → SQS → workers (2) → DynamoDB."
  ],
  "scoring": {
    "weights": {
      "performance": 0.35,
      "reliability": 0.3,
      "cost": 0.15,
      "architecture": 0.2
    },
    "latencyTargetMs": 60,
    "costBudget": 1800
  },
  "explanation": [
    "Chunk files (for example 4 MB blocks) and address chunks by their hash: identical chunks are stored once, and a small edit re-uploads one chunk.",
    "Metadata (folders, versions, chunk lists, sharing) must stay consistent per file: use transactions or conditional writes, and cache the hot parts.",
    "Clients learn about changes from a notification channel (long polling or WebSockets) and then pull only the chunks they're missing."
  ]
}
