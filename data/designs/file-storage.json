{
  "id": "file-storage",
  "order": 18,
  "title": "Cloud File Storage",
  "difficulty": "Hard",
  "summary": "Design a Dropbox-style service: upload files from any device, keep them in sync, and download them fast.",
  "scenario": [
    "Users keep folders in sync across laptops and phones. Files are split into chunks so only changed chunks upload again.",
    "File contents are huge and must never sit in the database; the metadata (who owns which chunk of which version) must stay consistent."
  ],
  "mode": "build",
  "category": "Storage",
  "requirements": {
    "functional": [
      "Upload and download files of any size",
      "Sync changes across a user's devices",
      "Keep version history",
      "Share a folder with other users"
    ],
    "nonFunctional": [
      "Handle 8,000 requests/s at peak",
      "Average latency at or below 90 ms (chunks come from object storage)",
      "Error rate at or below 1%",
      "Uploads processed without backlog",
      "No single points of failure",
      "Cost under $2,000 / month"
    ]
  },
  "estimates": [
    "8,000 requests/s at peak",
    "40% are chunk downloads served as blobs",
    "Of the rest, 60% are metadata/sync reads and 40% are uploads"
  ],
  "objectives": [
    {
      "id": "errors",
      "label": "Error rate at or below 1%",
      "metric": "errorRate",
      "op": "<=",
      "value": 0.01
    },
    {
      "id": "latency",
      "label": "Average latency at or below 90 ms",
      "metric": "avgLatencyMs",
      "op": "<=",
      "value": 90
    },
    {
      "id": "backlog",
      "label": "Queues keep up (no backlog)",
      "metric": "backlogRps",
      "op": "<=",
      "value": 0
    },
    {
      "id": "spof",
      "label": "No single points of failure",
      "metric": "spofCount",
      "op": "==",
      "value": 0
    },
    {
      "id": "cost",
      "label": "Monthly cost at or below $2,000",
      "metric": "monthlyCost",
      "op": "<=",
      "value": 2000
    },
    {
      "id": "uses-blob",
      "label": "File chunks live in object storage",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "objectStorage"
      ]
    },
    {
      "id": "uses-queue",
      "label": "Uploads are processed asynchronously",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "queue"
      ]
    },
    {
      "id": "uses-meta",
      "label": "Metadata is kept in a database",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "sqlDb",
        "nosqlDb"
      ]
    }
  ],
