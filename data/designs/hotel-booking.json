{
  "id": "hotel-booking",
  "order": 10,
  "title": "Hotel Booking",
  "difficulty": "Medium",
  "summary": "Design an Airbnb-style site: searching stays, browsing listings, and booking without double-booking a room.",
  "scenario": [
    "Travelers search by city and dates, browse listings with many photos, and book a room for specific nights.",
    "Popular listings get booked by several people at once around holidays."
  ],
  "mode": "build",
  "category": "Travel",
  "requirements": {
    "functional": [
      "Search listings by location and dates",
      "View listing pages and photos",
      "Book a room for specific nights",
      "Never double-book a night"
    ],
    "nonFunctional": [
      "Pages under 50 ms on average",
      "No double bookings",
      "No single point of failure",
      "Cost under $1,800 / month"
    ]
  },
  "estimates": [
    "5,000 requests/s at peak, 40% of them photos",
    "90% of API calls are reads",
    "70% of bookings collide with another booking"
  ],
