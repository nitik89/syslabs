{
  "id": "image-hosting",
  "order": 28,
  "title": "Image Hosting",
  "difficulty": "Medium",
  "summary": "Design an Imgur-style service: fast uploads, thumbnails generated in the background, and images served worldwide.",
  "scenario": [
    "Users upload images and share links. Popular images are viewed millions of times.",
    "Images are large and immutable, perfect for a CDN; thumbnails are generated after upload."
  ],
  "mode": "build",
  "category": "Media",
  "requirements": {
    "functional": [
      "Upload an image and get a link",
      "Serve images and thumbnails fast worldwide",
      "Generate thumbnails in the background",
      "Show image pages with metadata"
    ],
    "nonFunctional": [
      "Handle 25,000 requests/s at peak, 70% image downloads",
      "Average latency at or below 50 ms",
      "Error rate at or below 1%",
      "No single points of failure",
      "Cost under $1,900 / month"
    ]
  },
  "estimates": [
    "25,000 requests/s at peak",
    "70% are image downloads",
    "Of the rest, 90% are page reads and 10% uploads"
  ],
