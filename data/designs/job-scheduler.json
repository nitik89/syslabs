{
  "id": "job-scheduler",
  "order": 24,
  "title": "Distributed Job Scheduler",
  "difficulty": "Medium",
  "summary": "Accept millions of background jobs, run each one reliably, and let users check their status.",
  "scenario": [
    "Teams submit jobs (reports, exports, emails) that must run once, even if a worker crashes halfway.",
    "Submitting a job must be instant; status checks are frequent."
  ],
  "mode": "build",
  "category": "Platform",
  "requirements": {
    "functional": [
      "Submit a job with a payload",
      "Run every job at least once, with retries",
      "Check a job's status",
      "Cancel a queued job"
    ],
    "nonFunctional": [
      "Handle 3,000 requests/s at peak, 60% submissions",
      "Jobs are picked up without backlog",
      "Error rate at or below 1%",
      "No single points of failure",
      "Cost under $1,100 / month"
    ]
  },
  "estimates": [
    "3,000 requests/s at peak",
    "1,800 job submissions/s",
    "1,200 status checks/s, mostly for recent jobs"
  ],
  "objectives": [
