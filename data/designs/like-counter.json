{
  "id": "like-counter",
  "order": 31,
  "title": "Like Counter at Scale",
  "difficulty": "Medium",
  "summary": "Count likes on viral posts in real time without one hot post melting the database.",
  "scenario": [
    "A celebrity post gets hundreds of thousands of likes a minute, and everyone sees the count update.",
    "A naive counter (UPDATE likes = likes + 1) turns one row into a bottleneck."
  ],
  "mode": "build",
  "category": "Social",
  "requirements": {
    "functional": [
      "Like and unlike a post",
      "Show live like counts",
      "Never lose a like",
      "One user likes a post at most once"
    ],
    "nonFunctional": [
      "Handle 50,000 requests/s at peak, 60% reads",
      "Average latency at or below 60 ms",
      "Likes processed without backlog",
      "Error rate at or below 0.5%",
      "No single points of failure",
      "Cost under $7,700 / month"
    ]
  },
  "estimates": [
    "50,000 requests/s on a viral post",
    "20,000 likes/s",
    "95% of traffic is for one hot post"
  ],
