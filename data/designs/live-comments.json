{
  "id": "live-comments",
  "order": 21,
  "title": "Live Comments",
  "difficulty": "Medium",
  "summary": "Stream comments to everyone watching a live event, in real time, without dropping any.",
  "scenario": [
    "During a big live stream, viewers post comments and expect to see everyone else's within a second.",
    "Polling would melt the API: connections stay open, and new comments are pushed out to every viewer."
  ],
  "mode": "build",
  "category": "Messaging",
  "requirements": {
    "functional": [
      "Post a comment on a live stream",
      "See new comments in real time",
      "Load recent comments when joining",
      "Moderators can remove comments"
    ],
    "nonFunctional": [
      "Handle 30,000 requests/s at peak, 80% reads",
      "Average latency at or below 60 ms",
      "Error rate at or below 1%",
      "No single points of failure",
      "Cost under $4,500 / month"
    ]
  },
  "estimates": [
    "30,000 requests/s during a final",
    "6,000 new comments/s",
    "Most reads are for the same few live streams"
  ],
  "objectives": [
    {
      "id": "errors",
      "label": "Error rate at or below 1%",
      "metric": "errorRate",
      "op": "<=",
      "value": 0.01
    },
    {
      "id": "latency",
      "label": "Average latency at or below 60 ms",
      "metric": "avgLatencyMs",
      "op": "<=",
      "value": 60
    },
    {
      "id": "spof",
      "label": "No single points of failure",
      "metric": "spofCount",
      "op": "==",
      "value": 0
    },
    {
      "id": "cost",
      "label": "Monthly cost at or below $4,500",
      "metric": "monthlyCost",
      "op": "<=",
      "value": 4500
    },
    {
      "id": "uses-ws",
      "label": "Viewers hold real-time connections",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "websocketGateway"
      ]
    },
    {
      "id": "uses-pubsub",
      "label": "New comments fan out through pub/sub",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "queue"
      ]
    }
  ],
