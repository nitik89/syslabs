  "hints": [
    "Viewers shouldn't poll. What holds open connections and pushes updates to them?",
    "Each new comment has to reach every gateway with viewers of that stream: that's pub/sub.",
    "WebSocket gateway (6) → API (30) → Redis (2) → Cassandra (3); API → Redis Pub/Sub → writers (4) → Cassandra."
  ],
  "scoring": {
    "weights": {
      "performance": 0.35,
      "reliability": 0.3,
      "cost": 0.15,
      "architecture": 0.2
    },
    "latencyTargetMs": 40,
    "costBudget": 4140
  },
  "explanation": [
    "Connection gateways hold the sockets; a pub/sub channel per stream delivers each comment to every gateway with subscribers.",
    "Writes go through pub/sub to writers that persist them, so a viewer joining late can load recent comments from the store (cached).",
    "Huge streams sample or batch comments: nobody can read 5,000 comments a second anyway."
  ]
