  "hints": [
    "Services must never wait on log storage. What absorbs the firehose?",
    "Two destinations with different jobs: a search index for recent logs, object storage for everything.",
    "LB (2) → collectors (22) → Kafka → processors (16) → S3 (4); searches go to OpenSearch (2)."
  ],
  "scoring": {
    "weights": {
      "performance": 0.35,
      "reliability": 0.3,
      "cost": 0.15,
      "architecture": 0.2
