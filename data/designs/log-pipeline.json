{
  "id": "log-pipeline",
  "order": 27,
  "title": "Log Ingestion Pipeline",
  "difficulty": "Medium",
  "summary": "Collect logs from thousands of services, make recent ones searchable, and archive everything cheaply.",
  "scenario": [
    "Every service ships log lines. Engineers search the last few days during incidents; older logs are kept for audits.",
    "Ingestion is a firehose; searches are rare but must be fast."
  ],
  "mode": "build",
  "category": "Observability",
  "requirements": {
    "functional": [
      "Ingest log lines from every service",
      "Search recent logs by text and fields",
      "Archive all logs cheaply",
      "Never block a service that's logging"
    ],
    "nonFunctional": [
      "Handle 25,000 requests/s at peak, 95% ingestion",
      "Ingestion keeps up: no backlog",
      "Error rate at or below 1%",
      "No single points of failure",
      "Cost under $4,400 / month"
    ]
  },
  "estimates": [
    "25,000 log batches/s at peak",
    "1,250 searches/s during an incident",
    "Searches spread across many services"
  ],
  "objectives": [
    {
      "id": "errors",
      "label": "Error rate at or below 1%",
      "metric": "errorRate",
      "op": "<=",
      "value": 0.01
    },
    {
      "id": "backlog",
      "label": "Queues keep up (no backlog)",
      "metric": "backlogRps",
      "op": "<=",
      "value": 0
    },
    {
      "id": "spof",
      "label": "No single points of failure",
      "metric": "spofCount",
      "op": "==",
      "value": 0
    },
    {
      "id": "cost",
      "label": "Monthly cost at or below $4,400",
      "metric": "monthlyCost",
      "op": "<=",
      "value": 4400
    },
    {
      "id": "uses-stream",
      "label": "Logs are buffered in a stream",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "queue"
      ]
    },
    {
      "id": "uses-workers",
      "label": "Workers process and ship logs",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "worker"
      ]
    },
    {
      "id": "uses-search",
      "label": "Recent logs are searchable",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "search"
      ]
    },
    {
      "id": "uses-archive",
      "label": "Logs are archived in object storage",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "objectStorage"
      ]
    }
  ],
