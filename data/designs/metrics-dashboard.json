{
  "id": "metrics-dashboard",
  "order": 11,
  "title": "Metrics & Analytics",
  "difficulty": "Medium",
  "summary": "Design a Datadog-style metrics pipeline: ingest a firehose of data points and power dashboards.",
  "scenario": [
    "Thousands of servers send metrics every few seconds. Users open dashboards that chart them over time.",
    "Ingestion is relentless and must never fall behind."
  ],
  "mode": "build",
  "category": "Data",
  "requirements": {
    "functional": [
      "Ingest metric data points",
      "Store them by time",
      "Query ranges for dashboards"
    ],
    "nonFunctional": [
      "Ingestion keeps up (no backlog)",
      "No single point of failure",
      "Cost under $2,400 / month"
    ]
  },
  "estimates": [
    "20,000 requests/s at peak",
    "95% are writes (data points)",
    "Dashboards read recent time ranges"
  ],
  "objectives": [
    {
      "id": "errors",
      "label": "Error rate at or below 1%",
      "metric": "errorRate",
      "op": "<=",
      "value": 0.01
    },
    {
      "id": "backlog",
      "label": "Queues keep up (no backlog)",
      "metric": "backlogRps",
      "op": "<=",
      "value": 0
    },
    {
      "id": "spof",
      "label": "No single points of failure",
      "metric": "spofCount",
      "op": "==",
      "value": 0
    },
    {
      "id": "cost",
      "label": "Monthly cost at or below $2,400",
      "metric": "monthlyCost",
      "op": "<=",
      "value": 2400
    },
    {
      "id": "uses-tsdb",
      "label": "Metrics are stored in a time-series database",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "timeseriesDb"
      ]
    },
    {
      "id": "uses-stream",
      "label": "Ingestion is buffered by a stream or queue",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "queue"
      ]
    }
  ],
