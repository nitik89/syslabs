  "hints": [
    "A plain database can't answer 'everything within 2 km' quickly. What kind of index can?",
    "Searches cluster in city centres, so results for popular areas repeat: cache them by area.",
    "LB (2) → API (16) → Redis (2) → Elasticsearch geo index (5), and API → NoSQL for place details and writes."
  ],
  "scoring": {
    "weights": {
      "performance": 0.35,
