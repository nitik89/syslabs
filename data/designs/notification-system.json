{
  "id": "notification-system",
  "order": 8,
  "title": "Notification System",
  "difficulty": "Medium",
  "summary": "Design a system that authenticates and rate-limits senders, then delivers push, email and SMS at scale without falling behind.",
  "scenario": [
    "Every product event (a like, a message, a shipped order) makes an internal service ask you to notify a user by push, email or SMS.",
    "Callers must be authenticated, and a buggy service must not be able to flood users, so requests enter through a gateway that checks auth and rate-limits each sender.",
    "Delivery providers (APNs, FCM, SES, Twilio) are slow, so sending happens in the background, and nothing may pile up."
  ],
  "mode": "build",
  "category": "Messaging",
  "requirements": {
    "functional": [
      "Authenticate calling services and rate-limit noisy senders",
      "Accept notification requests from other services",
      "Deliver push, email and SMS in the background",
      "Store notification history and serve each user's inbox",
      "Read user preferences quickly (cached)",
      "Retry failed deliveries"
    ],
    "nonFunctional": [
      "Accept requests instantly",
      "Delivery keeps up (no backlog)",
      "Every component under 80% utilization",
      "Cost under $2,400 / month"
    ]
  },
  "estimates": [
    "10,000 notification requests/s at peak",
    "90% are sends (writes)",
    "10% are inbox / preference reads, mostly for active users (hot keys)"
  ],
  "objectives": [
