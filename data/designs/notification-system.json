{
  "id": "notification-system",
  "order": 8,
  "title": "Notification System",
  "difficulty": "Medium",
  "summary": "Design a system that sends push, email and SMS notifications at scale without falling behind.",
  "scenario": [
    "Every product event (a like, a message, a shipped order) can trigger notifications to users through push, email or SMS.",
    "Delivery providers are slow, so sending must happen in the background, and nothing may pile up."
  ],
  "mode": "build",
  "category": "Messaging",
  "requirements": {
    "functional": [
      "Accept notification requests from other services",
      "Deliver push, email and SMS",
      "Store notification history",
      "Retry failed deliveries"
    ],
    "nonFunctional": [
      "Accept requests instantly",
      "Delivery keeps up (no backlog)",
      "Every component under 80% utilization",
      "Cost under $2,400 / month"
    ]
  },
  "estimates": [
    "10,000 notification requests/s at peak",
    "90% are sends (writes)",
    "Users occasionally open their notification inbox (reads)"
  ],
  "objectives": [
    {
      "id": "errors",
      "label": "Error rate at or below 1%",
      "metric": "errorRate",
      "op": "<=",
      "value": 0.01
    },
    {
      "id": "backlog",
      "label": "Queues keep up (no backlog)",
      "metric": "backlogRps",
      "op": "<=",
      "value": 0
    },
    {
      "id": "headroom",
      "label": "No component above 80% utilization",
      "metric": "maxUtilization",
      "op": "<=",
      "value": 0.8
    },
    {
      "id": "cost",
      "label": "Monthly cost at or below $2,400",
      "metric": "monthlyCost",
      "op": "<=",
      "value": 2400
    },
    {
      "id": "uses-queue",
      "label": "Requests are queued",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
