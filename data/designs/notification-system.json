  "hints": [
    "The API should only accept and enqueue. Who does the slow delivery?",
    "Producers add 9,000 jobs/s. Workers must remove at least that many, with headroom.",
    "LB (2) \u2192 API (10) \u2192 Kafka \u2192 Delivery Workers (6) \u2192 NoSQL (3), plus API \u2192 NoSQL for inbox reads."
  ],
  "scoring": {
    "weights": {
