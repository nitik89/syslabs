{
  "id": "online-judge",
  "order": 17,
  "title": "Online Judge",
  "difficulty": "Hard",
  "summary": "Run untrusted code submissions against test cases at contest scale, and show results without melting under the rush.",
  "scenario": [
    "A coding-contest platform: thousands of people read problems, and when the clock ticks down, submissions spike.",
    "Each submission runs untrusted code in a sandbox, which is slow and must never block the website."
  ],
  "mode": "build",
  "category": "Developer tools",
  "requirements": {
    "functional": [
      "Browse problems and statements",
      "Submit code for a problem",
      "Run each submission in an isolated sandbox",
      "Show verdicts and the contest scoreboard"
    ],
    "nonFunctional": [
      "Handle 3,000 requests/s at peak, 30% submissions",
      "Website stays fast: average latency at or below 60 ms",
      "Error rate at or below 1%",
      "Judging keeps up: no backlog",
      "No single points of failure",
      "Cost under $3,000 / month"
    ]
  },
  "estimates": [
    "3,000 requests/s at the contest peak",
    "20% are static assets (editor JS, CSS)",
    "Of the rest, 70% are problem/scoreboard reads and 30% are submissions"
