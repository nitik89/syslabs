{
  "id": "order-saga",
  "order": 26,
  "title": "Order Checkout Saga",
  "difficulty": "Hard",
  "summary": "Place orders across inventory, payment and shipping services without overselling or losing an order.",
  "scenario": [
    "Checkout touches three services. If payment fails after stock was reserved, the reservation must be released.",
    "Popular items are contended: many buyers race for the last units, so reservations need coordination."
  ],
  "mode": "build",
  "category": "E-commerce",
  "requirements": {
    "functional": [
      "Reserve stock, charge payment, create shipment",
      "Compensate (release stock, refund) when a step fails",
      "Never oversell contended items",
      "Show order status"
    ],
    "nonFunctional": [
      "Handle 5,000 requests/s at peak, 50% orders",
      "No unsafe contended writes (no overselling)",
      "Order steps processed without backlog",
      "Error rate at or below 0.5%",
      "No single points of failure",
      "Cost under $1,400 / month"
    ]
  },
  "estimates": [
    "5,000 requests/s during a sale",
    "2,500 order steps/s",
    "30% of orders fight over hot items"
  ],
