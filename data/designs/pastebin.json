{
  "id": "pastebin",
  "order": 13,
  "title": "Pastebin",
  "difficulty": "Easy",
  "summary": "Design a text-sharing service: create a paste, get a short link, and serve it fast to everyone who opens it.",
  "scenario": [
    "Developers paste logs and snippets and share the link in chat. Most pastes are read a few times; a few go viral.",
    "Paste bodies can be large, so they shouldn't live in the database, and the popular ones should never touch it."
  ],
  "mode": "build",
  "category": "Storage",
  "requirements": {
    "functional": [
      "Create a paste and get a short link",
      "Open a paste by its link",
      "Download the raw paste body",
      "Pastes expire after a chosen time"
    ],
    "nonFunctional": [
      "Handle 6,000 requests/s at peak, 90% reads",
      "Average latency at or below 80 ms (raw downloads come from slower object storage)",
      "Error rate at or below 1%",
      "No single points of failure",
      "Cost under $1,500 / month"
    ]
  },
  "estimates": [
    "6,000 requests/s at peak",
    "30% are raw-body downloads (large blobs)",
    "Of the rest, 90% read paste metadata; 60% of those hit a few popular pastes"
  ],
