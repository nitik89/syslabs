{
  "id": "payments",
  "order": 6,
  "title": "Payments System",
  "difficulty": "Hard",
  "summary": "Design a Stripe-style payments API: correct balances, no double charges, and no downtime.",
  "scenario": [
    "Merchants call your API to charge cards and check balances. Every payment updates an account ledger.",
    "Retries and concurrent requests on the same account are common, and a double charge is unacceptable."
  ],
  "mode": "build",
  "category": "Fintech",
  "requirements": {
    "functional": [
      "Create charges",
      "Check balances and payment status",
      "Update the ledger exactly once per payment",
      "Authenticate and rate-limit API clients"
    ],
    "nonFunctional": [
      "Strongly consistent ledger",
      "No double charges",
      "No single point of failure",
      "Cost under $1,200 / month"
    ]
  },
  "estimates": [
    "1,500 API requests/s at peak",
    "40% are writes (charges, refunds)",
    "Half of writes touch an account that's busy at that moment"
  ],
  "objectives": [
    {
      "id": "errors",
      "label": "Error rate at or below 1%",
      "metric": "errorRate",
      "op": "<=",
      "value": 0.01
    },
    {
      "id": "latency",
      "label": "Average latency at or below 60 ms",
      "metric": "avgLatencyMs",
      "op": "<=",
      "value": 60
    },
    {
      "id": "spof",
      "label": "No single points of failure",
      "metric": "spofCount",
      "op": "==",
      "value": 0
    },
    {
      "id": "unsafe",
      "label": "No double bookings (contended writes are locked)",
      "metric": "unsafeWriteRps",
      "op": "==",
      "value": 0
    },
    {
      "id": "cost",
      "label": "Monthly cost at or below $1,200",
      "metric": "monthlyCost",
      "op": "<=",
      "value": 1200
    },
    {
      "id": "uses-sql",
      "label": "The ledger lives in a strongly consistent SQL database",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "sqlDb"
      ]
    },
    {
      "id": "uses-gateway",
      "label": "Requests pass through an API gateway (auth, rate limits)",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "apiGateway"
      ]
    }
  ],
