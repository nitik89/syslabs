  "id": "shopping-app",
  "order": 1,
  "title": "Shopping App",
  "difficulty": "Medium",
  "summary": "Design an online store: fast product pages, product search, images, and a checkout that never oversells.",
  "scenario": [
    "You're building the backend for a mid-size online store (think a smaller Amazon). Shoppers browse the catalog, search for products, look at lots of images and occasionally check out.",
    "Popular items get most of the views. During sales, many shoppers try to buy the last few units of the same item at once."
  ],
  "mode": "build",
  "category": "E-commerce",
  "requirements": {
    "functional": [
      "Browse product pages and categories",
      "Search products by keyword",
      "Show product images",
      "Place orders without overselling stock",
      "Send order confirmation emails"
    ],
    "nonFunctional": [
      "Product pages load in well under 100 ms",
      "Survives the loss of any single component",
      "Monthly cost under $2,000"
    ]
  },
  "estimates": [
    "10M daily users \u00d7 ~50 requests each \u2248 6,000 requests/s at peak",
    "Half of all requests are images, JS and CSS",
    "85% of API calls are reads; 30% of writes fight over the same stock"
  ],
