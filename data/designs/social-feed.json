{
  "id": "social-feed",
  "order": 3,
  "title": "Social Media Feed",
  "difficulty": "Hard",
  "summary": "Design an Instagram-style feed: photos, a home timeline, and celebrity posts seen by millions.",
  "scenario": [
    "Users post photos and scroll a home feed of posts from people they follow. Celebrities have tens of millions of followers.",
    "Most traffic is people scrolling feeds and loading images; posting is comparatively rare."
  ],
  "mode": "build",
  "category": "Social",
  "requirements": {
    "functional": [
      "Upload and view photos",
      "Home feed of followed accounts",
      "Like and comment",
      "Fan out new posts to followers' feeds"
    ],
    "nonFunctional": [
      "Feed loads in under 50 ms on average",
      "No single point of failure",
      "Fan-out keeps up (no backlog)",
      "Cost under $2,200 / month"
    ]
  },
  "estimates": [
    "100M daily users \u2248 30,000 requests/s at peak",
    "60% of requests are images",
    "90% of API calls are reads; celebrity posts make keys very hot"
  ],
