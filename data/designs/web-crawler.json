{
  "id": "web-crawler",
  "order": 15,
  "title": "Web Crawler",
  "difficulty": "Medium",
  "summary": "Crawl billions of pages politely: a URL frontier, fetchers that keep up, and storage for everything you download.",
  "scenario": [
    "A search startup needs to recrawl the web every few weeks. The scheduler hands out URLs; fetchers download pages and store them for indexing.",
    "Fetching is slow and bursty, so it must happen off the request path, and nothing may pile up in the frontier."
  ],
  "mode": "build",
  "category": "Data",
  "requirements": {
    "functional": [
      "Accept seed URLs and schedule them",
      "Fetch pages in the background",
      "Store raw pages for the indexer",
      "Skip URLs that were already crawled"
    ],
    "nonFunctional": [
      "Process 5,000 URL events/s at peak",
      "Frontier keeps up: no backlog",
      "Error rate at or below 1%",
      "No single points of failure",
      "Cost under $2,500 / month"
    ]
  },
  "estimates": [
    "5,000 URL events/s from the scheduler",
    "90% are new URLs to fetch (writes)",
    "10% are 'have we seen this URL?' lookups"
  ],
  "objectives": [
    {
      "id": "errors",
      "label": "Error rate at or below 1%",
      "metric": "errorRate",
      "op": "<=",
      "value": 0.01
    },
    {
      "id": "backlog",
      "label": "Queues keep up (no backlog)",
      "metric": "backlogRps",
      "op": "<=",
      "value": 0
    },
    {
      "id": "spof",
      "label": "No single points of failure",
      "metric": "spofCount",
      "op": "==",
      "value": 0
    },
    {
      "id": "cost",
      "label": "Monthly cost at or below $2,500",
      "metric": "monthlyCost",
      "op": "<=",
      "value": 2500
    },
    {
      "id": "uses-queue",
      "label": "URLs wait in a queue (the frontier)",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "queue"
      ]
    },
    {
      "id": "uses-workers",
      "label": "Fetchers run as background workers",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "worker"
      ]
    },
    {
      "id": "uses-blob",
      "label": "Raw pages are stored in object storage",
      "metric": "componentLoad",
      "op": ">=",
      "value": 1,
      "kinds": [
        "objectStorage"
      ]
    }
  ],
